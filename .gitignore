```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.tsbuildinfo

# Logs
*.log

# Environment
.env
.env.local
.env.*

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python artifacts (if any Python files exist in project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db
```